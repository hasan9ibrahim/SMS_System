{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alerts.incident.json",
  "title": "IncidentEvent",
  "description": "Topic alerts:<userId>, event \"incident\". An alert rule fired, changed or recovered (§13.6). Drives the pop-up card, the sound, the bell count and the alert dot on tabs (§13.5).",
  "type": "object",
  "required": ["incidentId", "ruleId", "ruleName", "state", "severity", "message", "metric", "currentValue", "startedAt"],
  "additionalProperties": false,
  "properties": {
    "incidentId": { "type": "integer", "minimum": 1 },
    "ruleId": { "type": "integer", "minimum": 1 },
    "ruleName": { "type": "string" },
    "state": { "type": "string", "enum": ["open", "acknowledged", "recovered"] },
    "severity": { "$ref": "common.json#/$defs/Severity" },
    "message": { "type": "string", "description": "Plain-words summary, e.g. \"Client X DLR dropped from 92 % to 61 % in 15 min\"." },
    "metric": { "type": "string", "enum": ["attempts", "submitted", "delivered", "tps", "asr", "dlr", "margin", "margin_pct", "revenue", "avg_delivery_delay", "bind_status"] },
    "currentValue": { "type": ["number", "null"] },
    "baselineValue": { "type": ["number", "null"] },
    "scope": { "type": "array", "items": { "$ref": "common.json#/$defs/PartyRef" } },
    "startedAt": { "$ref": "common.json#/$defs/Timestamp" },
    "endedAt": { "oneOf": [{ "$ref": "common.json#/$defs/Timestamp" }, { "type": "null" }] },
    "acknowledgedBy": { "type": ["string", "null"] }
  },
  "examples": [
    {
      "incidentId": 5001, "ruleId": 12, "ruleName": "DLR drop - key clients",
      "state": "open", "severity": "critical",
      "message": "Acme_DIRECT DLR dropped from 92 % to 61 % in 15 min",
      "metric": "dlr", "currentValue": 61, "baselineValue": 92,
      "scope": [{ "kind": "customer_trunk", "id": 101, "name": "Acme_DIRECT" }],
      "startedAt": "2026-10-16T07:45:00Z", "endedAt": null, "acknowledgedBy": null
    }
  ]
}
