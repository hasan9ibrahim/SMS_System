{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alerts.incident.json",
  "title": "IncidentEvent",
  "description": "Topic alerts:<userId>, event \"incident\". An alert rule fired, repeated, was acknowledged or snoozed, or recovered (§13.6). Drives the pop-up card, the sound, the bell count and the alert dot on tabs (§13.5). Sent only to the users the rule notifies.",
  "type": "object",
  "required": [
    "incidentId",
    "ruleId",
    "ruleName",
    "state",
    "severity",
    "message",
    "metric",
    "currentValue",
    "startedAt",
    "entityName",
    "channels",
    "repeat"
  ],
  "additionalProperties": false,
  "properties": {
    "incidentId": {
      "type": "integer",
      "minimum": 1
    },
    "ruleId": {
      "type": "integer",
      "minimum": 1
    },
    "ruleName": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "recovered"
      ]
    },
    "severity": {
      "$ref": "common.json#/$defs/Severity"
    },
    "message": {
      "type": "string",
      "description": "Plain-words summary, e.g. \"Client X DLR dropped from 92 % to 61 % in 15 min\"."
    },
    "metric": {
      "type": "string",
      "enum": [
        "attempts",
        "submitted",
        "delivered",
        "tps",
        "asr",
        "dlr",
        "margin",
        "margin_pct",
        "revenue",
        "avg_delivery_delay",
        "bind_status"
      ]
    },
    "currentValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "baselineValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/PartyRef"
      }
    },
    "startedAt": {
      "$ref": "common.json#/$defs/Timestamp"
    },
    "endedAt": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledgedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityName": {
      "type": "string",
      "description": "What the incident is about in words: a trunk, an enterprise, \"All traffic\" or a scope value."
    },
    "peakValue": {
      "type": [
        "number",
        "null"
      ],
      "description": "Worst value seen while open."
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "popup",
          "sound",
          "email"
        ]
      },
      "description": "How the rule notifies; popup and sound apply to the GUI."
    },
    "repeat": {
      "type": "boolean",
      "description": "True for a re-alert while the condition lasts (rule repeat interval)."
    },
    "snoozedUntil": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "No pop-up or sound until then."
    },
    "acknowledgedAt": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "condition": {
      "description": "The rule's condition (v0.90.0): type, fixed value or % change, baseline.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "baseline"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "above",
                "below",
                "increase_pct",
                "decrease_pct",
                "started",
                "stopped",
                "bind_down"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "baseline": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "previous_window",
                "yesterday",
                "last_week",
                null
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "windowMinutes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The rule's measuring window in minutes (v0.90.0)."
    },
    "breakdown": {
      "type": "array",
      "description": "Margin, ASR and DLR rules: the worst destinations over the window, worst first, at most 3 (v0.90.0).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "code",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    }
  },
  "examples": [
    {
      "incidentId": 5001,
      "ruleId": 12,
      "ruleName": "DLR drop - key clients",
      "state": "open",
      "severity": "critical",
      "message": "Acme_DIRECT DLR dropped from 92 % to 61 % in 15 min",
      "metric": "dlr",
      "currentValue": 61,
      "baselineValue": 92,
      "scope": [
        {
          "kind": "customer_trunk",
          "id": 101,
          "name": "Acme_DIRECT"
        }
      ],
      "startedAt": "2026-10-16T07:45:00Z",
      "endedAt": null,
      "acknowledgedBy": null,
      "entityName": "Acme_DIRECT",
      "peakValue": 58,
      "channels": [
        "popup",
        "sound",
        "email"
      ],
      "repeat": false,
      "snoozedUntil": null,
      "acknowledgedAt": null,
      "condition": {
        "type": "decrease_pct",
        "value": 20,
        "baseline": "previous_window"
      },
      "windowMinutes": 15,
      "breakdown": [
        {
          "name": "Brazil",
          "code": "BR",
          "value": 41.5
        }
      ]
    }
  ]
}
