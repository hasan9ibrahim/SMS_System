{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traffic.tps_tick.json",
  "title": "TpsTickEvent",
  "description": "Topic live:tps, event \"tick\". Per-trunk TPS samples, pushed once a second, for the live TPS chart and table (§13.3 items 3-4) and the TPS pill in the top menu bar (§15.1). Only trunks with traffic are listed: client trunks then vendor trunks, busiest first (the mock sends at most 60 and 40). totalTps is the platform total, counted on the client side.",
  "type": "object",
  "required": ["at", "totalTps", "trunks"],
  "additionalProperties": false,
  "properties": {
    "at": { "$ref": "common.json#/$defs/Timestamp" },
    "totalTps": { "type": "number", "minimum": 0 },
    "trunks": {
      "type": "array",
      "items": {
        "title": "TrunkTps",
        "type": "object",
        "required": ["trunk", "tps", "tpsLimit", "queueDepth"],
        "additionalProperties": false,
        "properties": {
          "trunk": { "$ref": "common.json#/$defs/PartyRef" },
          "tps": { "type": "number", "minimum": 0 },
          "tpsLimit": { "type": "number", "minimum": 0, "description": "Configured TPS; the UI shows % used, amber above 80 %, red at 100 %." },
          "queueDepth": { "type": "integer", "minimum": 0, "description": "Overflow buffer depth" }
        }
      }
    }
  },
  "examples": [
    {
      "at": "2026-10-16T08:00:01Z",
      "totalTps": 412.5,
      "trunks": [
        { "trunk": { "kind": "customer_trunk", "id": 101, "name": "Acme_DIRECT" }, "tps": 85, "tpsLimit": 100, "queueDepth": 0 }
      ]
    }
  ]
}
