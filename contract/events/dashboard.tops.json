{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard.tops.json",
  "title": "DashboardTopsEvent",
  "description": "Topic live:dashboard, event \"tops\". Daily top clients, top vendors (§13.3 item 5) and top destinations (item 6) for today (UTC), pushed every 5 s. Money is in the platform currency.",
  "type": "object",
  "required": [
    "at",
    "currency",
    "clients",
    "vendors",
    "destinations"
  ],
  "additionalProperties": false,
  "properties": {
    "at": {
      "$ref": "common.json#/$defs/Timestamp"
    },
    "currency": {
      "type": "string"
    },
    "clients": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopParty"
      }
    },
    "vendors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopParty"
      }
    },
    "destinations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopDestinationRow"
      }
    }
  },
  "$defs": {
    "TopParty": {
      "title": "TopParty",
      "type": "object",
      "required": [
        "party",
        "attempts",
        "money",
        "margin",
        "asr",
        "dlr"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {
          "$ref": "common.json#/$defs/PartyRef"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "money": {
          "type": "number",
          "description": "Revenue for a client, cost for a vendor."
        },
        "margin": {
          "type": "number"
        },
        "asr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dlr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TopDestinationRow": {
      "title": "TopDestinationRow",
      "type": "object",
      "required": [
        "mccmnc",
        "country",
        "network",
        "attempts",
        "revenue",
        "margin",
        "asr",
        "dlr"
      ],
      "additionalProperties": false,
      "properties": {
        "mccmnc": {
          "type": "string",
          "pattern": "^[0-9]{3,6}$"
        },
        "country": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "revenue": {
          "type": "number"
        },
        "margin": {
          "type": "number"
        },
        "asr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dlr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "examples": [
    {
      "at": "2026-10-16T08:00:05Z",
      "currency": "EUR",
      "clients": [
        {
          "party": {
            "kind": "customer_enterprise",
            "id": 7,
            "name": "Acme Messaging"
          },
          "attempts": 182000,
          "money": 5210.4,
          "margin": 610.2,
          "asr": 95.4,
          "dlr": 87.1
        }
      ],
      "vendors": [
        {
          "party": {
            "kind": "vendor_enterprise",
            "id": 9,
            "name": "Kite Networks"
          },
          "attempts": 150000,
          "money": 4120.0,
          "margin": 520.5,
          "asr": 96.0,
          "dlr": 88.0
        }
      ],
      "destinations": [
        {
          "mccmnc": "99901",
          "country": "Fakeland",
          "network": "Example Mobile",
          "attempts": 82000,
          "revenue": 2400.1,
          "margin": 300.4,
          "asr": 95.0,
          "dlr": 86.0
        }
      ]
    }
  ]
}
