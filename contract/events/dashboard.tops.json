{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard.tops.json",
  "title": "DashboardTopsEvent",
  "description": "Topic live:dashboard, event \"tops\". Daily top clients, top vendors (\u00a713.3 item 5) and top destinations by country, all networks together (item 6, team trial round 2) for today (the day in the platform time zone, `ReferenceData.platformTimezone`), pushed every 5 s. Money is in the platform currency.",
  "type": "object",
  "required": [
    "at",
    "currency",
    "clients",
    "vendors",
    "destinations"
  ],
  "additionalProperties": false,
  "properties": {
    "at": {
      "$ref": "common.json#/$defs/Timestamp"
    },
    "currency": {
      "type": "string"
    },
    "clients": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopParty"
      }
    },
    "vendors": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopParty"
      }
    },
    "destinations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/TopDestinationRow"
      }
    }
  },
  "$defs": {
    "TopParty": {
      "title": "TopParty",
      "type": "object",
      "required": [
        "party",
        "attempts",
        "money",
        "margin",
        "asr",
        "dlr"
      ],
      "additionalProperties": false,
      "properties": {
        "party": {
          "$ref": "common.json#/$defs/PartyRef"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "money": {
          "type": [
            "number",
            "null"
          ],
          "description": "Revenue for a client, cost for a vendor. Null when withheld by the viewer's visibility policy (\u00a713.17)."
        },
        "margin": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when withheld by the viewer's visibility policy (\u00a713.17)."
        },
        "asr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dlr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "TopDestinationRow": {
      "title": "TopDestinationRow",
      "type": "object",
      "description": "A destination country today, all its networks together (team trial round 2).",
      "required": [
        "iso",
        "country",
        "networks",
        "attempts",
        "revenue",
        "margin",
        "asr",
        "dlr"
      ],
      "additionalProperties": false,
      "properties": {
        "iso": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 code; filters reports on `country`."
        },
        "country": {
          "type": "string"
        },
        "networks": {
          "type": "integer",
          "minimum": 1,
          "description": "Networks of the country with traffic today."
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "revenue": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when withheld by the viewer's visibility policy (\u00a713.17)."
        },
        "margin": {
          "type": [
            "number",
            "null"
          ],
          "description": "Null when withheld by the viewer's visibility policy (\u00a713.17)."
        },
        "asr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dlr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  "examples": [
    {
      "at": "2026-10-16T08:00:05Z",
      "currency": "EUR",
      "clients": [
        {
          "party": {
            "kind": "customer_enterprise",
            "id": 7,
            "name": "Acme Messaging"
          },
          "attempts": 182000,
          "money": 5210.4,
          "margin": 610.2,
          "asr": 95.4,
          "dlr": 87.1
        }
      ],
      "vendors": [
        {
          "party": {
            "kind": "vendor_enterprise",
            "id": 9,
            "name": "Kite Networks"
          },
          "attempts": 150000,
          "money": 4120.0,
          "margin": 520.5,
          "asr": 96.0,
          "dlr": 88.0
        }
      ],
      "destinations": [
        {
          "iso": "FK",
          "country": "Fakeland",
          "networks": 3,
          "attempts": 82000,
          "revenue": 2400.1,
          "margin": 300.4,
          "asr": 95.0,
          "dlr": 86.0
        }
      ]
    }
  ]
}
