{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard.movers.json",
  "title": "DashboardMoversEvent",
  "description": "Topic live:dashboard, event \"movers\". Traffic movers panel (§13.3 item 2), pushed every 5 s, comparing the last window with the window before: customer trunks that started or stopped sending, and the customer trunks and vendor trunks whose traffic changed (team trial round 2: Customer and Vendor in place of Increasing and Decreasing, biggest change first), each with the destination it sends most to. A trunk shows in Customer or Vendor only when it sent at least the card's volume (messages in the window, now or before). Window and volumes come from the join parameters (dashboard.join.json).",
  "type": "object",
  "required": [
    "at",
    "windowMinutes",
    "customerMinMessages",
    "vendorMinMessages",
    "started",
    "customers",
    "vendors",
    "stopped"
  ],
  "additionalProperties": false,
  "properties": {
    "at": {
      "$ref": "common.json#/$defs/Timestamp"
    },
    "windowMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "customerMinMessages": {
      "type": "integer",
      "minimum": 0,
      "description": "Customer card: least messages in the window (now or before)."
    },
    "vendorMinMessages": {
      "type": "integer",
      "minimum": 0,
      "description": "Vendor card: least messages in the window (now or before)."
    },
    "started": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoverRow"
      }
    },
    "customers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoverRow"
      },
      "description": "Customer trunks whose traffic changed, biggest change first."
    },
    "vendors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoverRow"
      },
      "description": "Vendor trunks whose traffic changed, biggest change first."
    },
    "stopped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoverRow"
      }
    }
  },
  "$defs": {
    "MoverRow": {
      "title": "MoverRow",
      "type": "object",
      "required": [
        "trunk",
        "enterprise",
        "tpsNow",
        "tpsBefore",
        "changePct",
        "sparkline",
        "asr",
        "dlr",
        "messagesNow",
        "messagesBefore",
        "topDestination"
      ],
      "additionalProperties": false,
      "properties": {
        "trunk": {
          "$ref": "common.json#/$defs/PartyRef"
        },
        "enterprise": {
          "$ref": "common.json#/$defs/PartyRef",
          "description": "Its enterprise (customer_enterprise for a customer trunk, vendor_enterprise for a vendor trunk)."
        },
        "tpsNow": {
          "type": "number",
          "minimum": 0,
          "description": "Average TPS over the last window."
        },
        "tpsBefore": {
          "type": "number",
          "minimum": 0,
          "description": "Average TPS over the window before."
        },
        "changePct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Change in %; null when there was no traffic before (started)."
        },
        "sparkline": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "number",
            "minimum": 0
          },
          "description": "Average TPS per minute over the last 60 minutes, oldest first."
        },
        "asr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "dlr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "messagesNow": {
          "type": "integer",
          "minimum": 0,
          "description": "Messages in the last window."
        },
        "messagesBefore": {
          "type": "integer",
          "minimum": 0,
          "description": "Messages in the window before."
        },
        "topDestination": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "mccmnc",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "mccmnc": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "Country and network."
            }
          },
          "description": "The destination the trunk sent most to in the last hour; null when unknown."
        }
      }
    }
  },
  "examples": [
    {
      "at": "2026-10-16T08:00:05Z",
      "windowMinutes": 15,
      "started": [
        {
          "trunk": {
            "kind": "customer_trunk",
            "id": 101,
            "name": "Acme_DIRECT"
          },
          "enterprise": {
            "kind": "customer_enterprise",
            "id": 7,
            "name": "Acme Messaging"
          },
          "tpsNow": 12.5,
          "tpsBefore": 0,
          "changePct": null,
          "sparkline": [
            0,
            0,
            0,
            10.2,
            12.5
          ],
          "asr": 96.1,
          "dlr": 88.4,
          "messagesNow": 11250,
          "messagesBefore": 0,
          "topDestination": {
            "mccmnc": "40474",
            "name": "India BSNL"
          }
        }
      ],
      "stopped": [],
      "customerMinMessages": 100,
      "vendorMinMessages": 100,
      "customers": [],
      "vendors": []
    }
  ]
}
