{
  "name": "@sms/contract",
  "version": "0.1.0",
  "private": true,
  "description": "API contract (OpenAPI 3.1 + WebSocket event schemas) and the TypeScript types generated from it",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./openapi.yaml": "./openapi.yaml",
    "./events/*": "./events/*"
  },
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "gen:check": "node scripts/generate.mjs --check",
    "lint": "redocly lint openapi.yaml --config redocly.yaml",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.64.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
