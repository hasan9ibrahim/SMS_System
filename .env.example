# Local development defaults for docker-compose and the mock server.
# Copy to .env and change as needed. These are FAKE local-only values (CLAUDE.md rule 1);
# never put real credentials in this file or anywhere in the repo.

# PostgreSQL: configuration data (spec §14)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sms_config
POSTGRES_USER=sms_dev
POSTGRES_PASSWORD=sms_dev_password

# ClickHouse: EDRs and reports (spec §14)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=sms_edr
CLICKHOUSE_USER=sms_dev
CLICKHOUSE_PASSWORD=sms_dev_password

# Redis: live counters (spec §14)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mock server (contract implementation for the frontend phase)
MOCK_HOST=127.0.0.1
MOCK_PORT=4010

# Web dev server proxies /api and /socket to the mock server
VITE_API_TARGET=http://127.0.0.1:4010

# Platform currency for converted rates, margins and cross-company totals (decided 2026-10-16)
PLATFORM_CURRENCY=EUR

# Platform time zone, one of the Enterprise report time zone choices (§13.31)
PLATFORM_TIMEZONE=UTC

# Shared trial instance (docs/TRIAL_GUIDE.md): one team username and password the browser asks for
# before the web app loads. Empty password = no prompt. Pick your own; never commit it.
WEB_PORT=8080
TEAM_USER=team
TEAM_PASSWORD=

# Live traffic simulator: messages per second across the platform (0 = the stored EDRs' own rate).
SIM_TOTAL_TPS=40

# Event bus for the Elixir backend (docs/BACKEND_PLAN.md): comma-separated host:port of the NATS servers.
NATS_HOSTS=localhost:4222

# SMPP listeners of the Elixir switch (backend/, step 2): 2775 plain and 2776 TLS. The TLS port needs a certificate
# and key (PEM files; without them it stays closed in development). Ports behind a load balancer that sends a PROXY
# header go in SMPP_PROXY_PORTS too.
SMPP_PORTS=2775
SMPP_TLS_PORTS=2776
SMPP_TLS_CERTFILE=
SMPP_TLS_KEYFILE=
SMPP_PROXY_PORTS=
SMPP_SYSTEM_ID=SMSC
SWITCH_CLUSTER_SIZE=2
# Each switch server's own number, 0-255, different on every server: it is part of the message ids customers get
# (backend/, step 4). The switch also reads PLATFORM_CURRENCY above for rates and margins.
SWITCH_NODE_ID=0
# The other switch servers' node names (name@host, comma-separated); empty runs one server alone (backend step 7).
SWITCH_PEERS=
# Overload guard (step 7): new submits get 0x58 while accepted messages wait longer than this for the sender (ms;
# overflow-buffer messages do not count), or more than SWITCH_MAX_BACKLOG are unfinished (a safety cap). 0 = off.
SWITCH_MAX_WAIT_MS=10000
SWITCH_MAX_BACKLOG=100000
# On the servers (backend step 8, deploy/ansible writes these): the witness VM's node (one of SWITCH_PEERS), the health
# and metrics port (0 = off), "witness" on the witness VM, Patroni's /primary and the step-back hook (Sms.Switch.Fence),
# and the Redis sentinels (host:port, comma-separated) with their group and password.
SWITCH_WITNESS=
SWITCH_HTTP_PORT=0
SWITCH_ROLE=switch
SWITCH_PRIMARY_URL=
SWITCH_FENCE_HOOK=
REDIS_SENTINELS=
REDIS_SENTINEL_GROUP=sms
REDIS_SENTINEL_PASSWORD=
# The Elixir API (backend step 9, backend/apps/sms_api): its port (0 = off), the mock server it forwards the calls it
# has not ported to, the secret both share (the mock takes the signed-in user from the API only with it), Phoenix's key
# base, the client address from nginx (1 behind nginx) and Secure cookies behind HTTPS.
API_PORT=0
MOCK_URL=http://127.0.0.1:4010
MOCK_PROXY_SECRET=dev-only-proxy-secret
SECRET_KEY_BASE=
TRUST_PROXY=
COOKIE_SECURE=
# The mock checks staff sign-in itself only with 1 (otherwise it acts as MOCK_USER_ID, default 1, as before).
MOCK_REQUIRE_SIGN_IN=

# Vendor connections of the Elixir switch (backend/, step 3): "peer" checks each vendor's TLS certificate against the
# system CAs and its host name; "none" accepts any certificate (a vendor with a self-signed one).
VENDOR_TLS_VERIFY=peer
