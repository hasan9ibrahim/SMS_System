# Trial server settings (deploy/server/README.md). Copy to .env on the server and fill in.
# Fake data only (CLAUDE.md rule 1). Never commit the filled-in file. Avoid "$" in values.

# Database passwords: long random values, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Key the API server encrypts stored secrets with (fake trial secrets only)
MOCK_SECRET_KEY=

# The one username and password the browser asks for before the site loads
TEAM_USER=team
TEAM_PASSWORD=

# Where the web app listens. Keep 127.0.0.1 when Caddy serves your domain over HTTPS.
WEB_BIND=127.0.0.1:8080

# Live traffic simulator, messages per second
SIM_TOTAL_TPS=40
PLATFORM_CURRENCY=EUR
PLATFORM_TIMEZONE=UTC

# Image source: main = latest build of main; a commit SHA pins one version
IMAGE_REGISTRY=ghcr.io/hasan9ibrahim
IMAGE_TAG=main
