# The web app built for production and served by nginx, which also proxies /api and /socket to the
# mock server (later: to the Phoenix backend, with no change to the screens).
FROM node:22.11.0-alpine3.20 AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY contract/package.json contract/
COPY mock/package.json mock/
COPY web/package.json web/
RUN npm ci --workspace=contract --workspace=web --no-audit --no-fund
COPY contract contract
COPY web web
RUN npm run build -w web

FROM nginx:1.27.2-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
