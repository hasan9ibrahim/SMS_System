# {{ ansible_managed }} (deploy/ansible/roles/nats)
server_name: {{ inventory_hostname }}
listen: 0.0.0.0:{{ ports.nats }}
http: 0.0.0.0:{{ ports.nats_monitor }}
max_payload: 4MB

authorization {
  users: [
    {user: sms, password: "{{ vault_nats_password }}"}
  ]
}

jetstream {
  store_dir: /var/lib/nats/jetstream
  # Ceiling for the stored events (2 days kept, max_age_days): ~40 GB at 50 M messages a month, so 200 GB leaves room on
  # a 1.92 TB server disk (product owner 2026-10-26). The witness VM sets its own (inventory).
  max_file_store: {{ nats_max_file_store | default('200G' if not lab else '2G') }}
  max_memory_store: {{ nats_max_memory_store | default('1G' if not lab else '128M') }}
  # The NATS default (written to disk every 2 minutes): each event is on three machines, so one crashing loses
  # nothing (product owner 2026-10-25, backend step 7).
}

{% if not single_server %}
cluster {
  name: sms
  listen: 0.0.0.0:{{ ports.nats_cluster }}
  routes: [
{% for h in cluster_hosts if h != inventory_hostname %}
    nats-route://{{ hostvars[h].private_ip }}:{{ ports.nats_cluster }}
{% endfor %}
  ]
}
{% else %}
# One server alone (inventories/single.example): JetStream on its own, each event once (NATS refuses a cluster of one).
# Adding the second server and the witness turns this into the three-machine cluster (docs/DEPLOY_SINGLE_SERVER.md).
{% endif %}
