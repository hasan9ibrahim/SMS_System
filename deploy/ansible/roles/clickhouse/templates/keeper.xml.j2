<!-- {{ ansible_managed }} (deploy/ansible/roles/clickhouse): the third Keeper voter, on the witness. -->
<clickhouse>
  <listen_host>0.0.0.0</listen_host>
  <keeper_server>
    <tcp_port>{{ ports.keeper }}</tcp_port>
    <!-- The three machines talk over IPv4 (the raft port binds IPv6 by default). -->
    <enable_ipv6>false</enable_ipv6>
    <server_id>{{ cluster_hosts.index(inventory_hostname) + 1 }}</server_id>
    <log_storage_path>/var/lib/clickhouse-keeper/log</log_storage_path>
    <snapshot_storage_path>/var/lib/clickhouse-keeper/snapshots</snapshot_storage_path>
    <coordination_settings>
      <operation_timeout_ms>10000</operation_timeout_ms>
      <session_timeout_ms>30000</session_timeout_ms>
    </coordination_settings>
    <raft_configuration>
{% for h in cluster_hosts %}
      <server><id>{{ loop.index }}</id><hostname>{{ hostvars[h].private_ip }}</hostname><port>{{ ports.keeper_raft }}</port></server>
{% endfor %}
    </raft_configuration>
  </keeper_server>
</clickhouse>
