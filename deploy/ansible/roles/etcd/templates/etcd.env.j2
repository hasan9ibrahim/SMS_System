# {{ ansible_managed }} (deploy/ansible/roles/etcd)
ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="/var/lib/etcd/default"
ETCD_LISTEN_PEER_URLS="http://{{ private_ip }}:{{ ports.etcd_peer }}"
ETCD_LISTEN_CLIENT_URLS="http://{{ private_ip }}:{{ ports.etcd_client }},http://127.0.0.1:{{ ports.etcd_client }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="http://{{ private_ip }}:{{ ports.etcd_peer }}"
ETCD_ADVERTISE_CLIENT_URLS="http://{{ private_ip }}:{{ ports.etcd_client }}"
ETCD_INITIAL_CLUSTER="{% for h in cluster_hosts %}{{ h }}=http://{{ hostvars[h].private_ip }}:{{ ports.etcd_peer }}{{ ',' if not loop.last }}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="sms-etcd"
ETCD_ENABLE_V2="false"
