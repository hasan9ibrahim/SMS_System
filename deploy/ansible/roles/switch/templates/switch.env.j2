# {{ ansible_managed }} (deploy/ansible/roles/switch). Names as in the repository's .env.example.
SWITCH_NODE_NAME=sms@{{ private_ip }}
RELEASE_COOKIE={{ vault_release_cookie }}
SWITCH_PEERS={{ cluster_hosts | reject('equalto', inventory_hostname) | map('extract', hostvars, 'private_ip') | map('regex_replace', '^', 'sms@') | join(',') }}
SWITCH_WITNESS=sms@{{ witness_ip }}
SWITCH_HTTP_PORT={{ ports.switch_http }}
{% if inventory_hostname in groups['witness'] %}
SWITCH_ROLE=witness
SMPP_PORTS=
SMPP_TLS_PORTS=
{% else %}
SWITCH_ROLE=switch
SWITCH_NODE_ID={{ node_id }}
SWITCH_CLUSTER_SIZE={{ groups['servers'] | length }}
PLATFORM_CURRENCY={{ platform_currency }}

# PostgreSQL through the local HAProxy: always the current primary.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT={{ ports.pg_primary }}
POSTGRES_DB={{ pg_database }}
POSTGRES_USER={{ pg_app_user }}
POSTGRES_PASSWORD={{ vault_pg_app_password }}
PG_SCHEMA=sms

# Redis: the primary the sentinels name.
REDIS_SENTINELS={% for h in cluster_hosts %}{{ hostvars[h].private_ip }}:{{ ports.sentinel }}{{ ',' if not loop.last }}{% endfor %}

REDIS_SENTINEL_GROUP={{ redis_sentinel_group }}
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_SENTINEL_PASSWORD={{ vault_redis_password }}

# NATS: the two servers (the witness holds the third copy of every event but takes no clients).
NATS_HOSTS={% for h in groups['servers'] %}{{ hostvars[h].private_ip }}:{{ ports.nats }}{{ ',' if not loop.last }}{% endfor %}

NATS_USER=sms
NATS_PASSWORD={{ vault_nats_password }}

# ClickHouse on this server (replicated to the other).
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT={{ ports.ch_http }}
CLICKHOUSE_DB={{ ch_database }}
CLICKHOUSE_USER={{ ch_app_user }}
CLICKHOUSE_PASSWORD={{ vault_clickhouse_password }}

SMPP_PORTS={{ ports.smpp | join(',') }}
{% if smpp_tls_certfile is defined %}
SMPP_TLS_PORTS={{ ports.smpp_tls | join(',') }}
SMPP_TLS_CERTFILE={{ smpp_tls_certfile }}
SMPP_TLS_KEYFILE={{ smpp_tls_keyfile }}
{% else %}
SMPP_TLS_PORTS=
{% endif %}
{% endif %}
