# {{ ansible_managed }} (deploy/ansible/roles/service). Names as in mock/src (mode.ts, db.ts, edr.ts, jobs/mailer.ts).
SMS_MODE=production
NODE_ENV=production
# Behind the API on this server only (it forwards with MOCK_PROXY_SECRET); nginx sends the live WebSocket here too.
MOCK_HOST=127.0.0.1
MOCK_PORT={{ service_port }}
TRUST_PROXY=1
COOKIE_SECURE=1
PUBLIC_URL=https://{{ web_domain }}
PLATFORM_CURRENCY={{ platform_currency }}
PLATFORM_TIMEZONE={{ platform_timezone }}
SWITCH_NODES={{ groups['servers'] | length }}
SMS_DB_DIR={{ service_root }}/current/db
SMS_DATA_DIR={{ service_root }}/current/data
SMS_CONTRACT_FILE={{ service_root }}/current/contract/openapi.yaml

MOCK_PROXY_SECRET={{ vault_mock_proxy_secret }}
MOCK_SECRET_KEY={{ vault_mock_secret_key }}

# PostgreSQL through the local HAProxy: always the current primary.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT={{ ports.pg_primary }}
POSTGRES_DB={{ pg_database }}
POSTGRES_USER={{ pg_app_user }}
POSTGRES_PASSWORD={{ vault_pg_app_password }}

# ClickHouse on this server (replicated to the other).
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT={{ ports.ch_http }}
CLICKHOUSE_DB={{ ch_database }}
CLICKHOUSE_USER={{ ch_app_user }}
CLICKHOUSE_PASSWORD={{ vault_clickhouse_password }}

# NATS: this server's own node (the switch's events, the switch commands).
NATS_URL=nats://sms:{{ vault_nats_password | urlencode }}@127.0.0.1:{{ ports.nats }}

# Platform e-mail (sign-in codes, alerts); partner e-mail goes through the business companies' mailboxes. Quoted, so
# `. service.env` (docs/GO_LIVE.md step 4) reads a sender name with spaces as systemd does.
SMTP_URL='{{ vault_smtp_url | default('') }}'
SMTP_FROM='{{ smtp_from | default('') }}'
SMTP_FROM_NAME='{{ smtp_from_name }}'
