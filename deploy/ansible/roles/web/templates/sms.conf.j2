# {{ ansible_managed }} (deploy/ansible/roles/web). The screens, the API and the live WebSocket under one name.
server {
  listen 80;
  server_name {{ web_domain }};
  return 301 https://$host$request_uri;
}

server {
  # "listen ... http2" as Ubuntu 24.04 has nginx 1.24 (the "http2" directive came in 1.25).
  listen 443 ssl http2;
  server_name {{ web_domain }};
  root {{ web_root }}/current;

  ssl_certificate {{ web_tls_certfile }};
  ssl_certificate_key {{ web_tls_keyfile }};
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:sms:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy same-origin always;

  # Imports and uploads (Migration Center, rate files) send up to 16 MB of JSON.
  client_max_body_size 32m;

  # The API on this server (apps/sms_api): sign-in, the ported operations, and the rest forwarded to the service.
  location /api/ {
    proxy_pass http://127.0.0.1:{{ ports.api }};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_buffering off;
  }

  # Phoenix-protocol WebSocket (live dashboard, analytics, alerts, hover volumes): the TypeScript service.
  location /socket {
    proxy_pass http://127.0.0.1:{{ service_port }};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
  }

  location /assets/ {
    expires 7d;
    add_header Cache-Control "public, immutable";
    add_header Strict-Transport-Security "max-age=31536000" always;
  }

  # Client-side routes (every page path, the customer portal, tabs dragged out into their own window).
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;
  }
}
